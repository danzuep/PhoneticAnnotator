<Project Sdk="NetWasm.Sdk/0.10.2" TreatAsLocalProperty="PublishAot">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netwasm0.1</TargetFrameworks>
    <PackageId>Zue.PhoneticAnnotator.Core</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\Unihan\Unihan.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netwasm0.1'">
    <Compile Remove="UnihanArchiveLoader.cs;UnihanLookupLoader.cs;UnihanCharacterReadingProvider.cs" />
    <Compile Include="../Unihan/Models/UnihanField.cs" Link="UnihanField.cs" />
    <PackageReference Include="NetWasm.System.Linq" Version="0.10.0" />
    <PackageReference Include="NetWasm.System.Text.Json" Version="0.10.0" />
  </ItemGroup>

</Project>
