<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishTrimmed>true</PublishTrimmed>
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="PhoneticAnnotator.d.ts;phonetic-annotator-worker.js" Link="wwwroot/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../PhoneticAnnotator.Core/PhoneticAnnotator.Core.csproj" />
    <Content Include="demo/**/*" Link="wwwroot/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/examples/word-readings.tsv" Link="wwwroot/word-readings.tsv"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../data/Unihan_Readings.txt" Link="wwwroot/Unihan_Readings.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="wwwroot/THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateInteropTypes" BeforeTargets="PrepareForBuild;PrepareForPublish"
          Condition="'$(SkipInteropTypeGeneration)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../../scripts/generate-types.mjs&quot;" />
  </Target>

</Project>
